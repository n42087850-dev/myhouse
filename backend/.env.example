# Nusxa oling: cp .env.example .env  va qiymatlarni to'ldiring. .env ni GITGA QO'SHMANG.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Ixtiyoriy: brigada chaqirish arizalari alohida chatga ketsin (bo'sh bo'lsa TELEGRAM_CHAT_ID ishlatiladi)
TELEGRAM_CREW_CHAT_ID=

# Frontend manzillari (vergul bilan). Productionda faqat o'z domeningiz.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Bitta IP dan: RATE_LIMIT_MAX ta buyurtma / RATE_LIMIT_WINDOW_SEC soniya
RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW_SEC=600
# Nginx/Cloudflare orqasida bo'lsangiz true qiling (X-Forwarded-For ga ishonadi)
TRUST_PROXY=false
